# ==============================================================================
# CollegeGuide AI — Production & Local Environment Variables Reference
# ==============================================================================
# Copy this file to backend/.env and frontend/.env or configure in your cloud host.
# NEVER commit your actual .env files with real credentials to Git!

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (backend/.env or Render / Railway / Server Env Vars)
# ------------------------------------------------------------------------------

# Database Connection:
# Local SQLite fallback (included zero-setup default):
DATABASE_URL=sqlite:///./college_guide.db

# Hosted MySQL (e.g., PlanetScale, Aiven, AWS RDS):
# DATABASE_URL=mysql+pymysql://user:password@host.cloud.com:3306/college_guide_ai

# Hosted PostgreSQL (e.g., Render Postgres, Supabase, Neon):
# DATABASE_URL=postgresql://user:password@ep-host.neon.tech/college_guide_ai

# Vector Search & RAG Embeddings:
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
FAISS_INDEX_DIR=./data/index
DOCUMENTS_DIR=./data/documents

# Cloud LLM Configuration (OpenRouter OpenAI-compatible API):
# Get your API key from https://openrouter.ai/keys
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local SLM Fallback (Independent Ollama instance, optional):
OLLAMA_BASE_URL=http://localhost:11434

# Security Key for Admin Ingestion Endpoints (change to a random secure string):
ADMIN_API_KEY=collegeguide-secret-admin-key-change-me

# CORS Allowed Origins (Comma-separated URLs or * in development):
CORS_ORIGINS=https://collegeguide-frontend.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env or Vercel / Render Static Site Env Vars)
# ------------------------------------------------------------------------------

# Public Backend API URL (leave empty for same-origin dev proxy, or set to your deployed backend):
# VITE_API_URL=https://collegeguide-backend.onrender.com
VITE_API_URL=http://localhost:8000
