# College Guide AI - Environment Configuration

# Database Configuration
# Default is local SQLite fallback for instant zero-configuration testing.
# For production MySQL, set your credentials:
# DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/college_guide_ai
DATABASE_URL=sqlite:///./college_guide.db

# Vector Index & Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
FAISS_INDEX_DIR=./data/index
DOCUMENTS_DIR=./data/documents

# Cloud LLM Configuration (OpenRouter via OpenAI-compatible endpoint)
# Get your API key from https://openrouter.ai/keys
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local SLM Configuration (Independent Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Security Key for Admin Ingestion Endpoints
ADMIN_API_KEY=admin-secret-key-change-in-production
