# College Guide AI - Environment Configuration

# Database Configuration
# Default is local SQLite fallback for instant zero-configuration testing.
# For production MySQL, set your credentials:
# DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/college_guide_ai
DATABASE_URL=sqlite:///./college_guide.db

# Vector Index & Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
FAISS_INDEX_DIR=./data/index
DOCUMENTS_DIR=./data/documents

# LLM Provider Configuration
# Supported providers: gemini, openai, groq, ollama, fallback
LLM_PROVIDER=fallback
LLM_API_KEY=
LLM_MODEL_NAME=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434

# Security Key for Admin Ingestion Endpoints
ADMIN_API_KEY=admin-secret-key-change-in-production
